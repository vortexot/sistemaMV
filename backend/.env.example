APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=mv_multimarcas
# Generate a random secret (at least 32 bytes); never use this file as credentials.
JWT_SECRET=
# Generate separately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Temporary during controlled rotation. Remove after all MFA secrets use the current key.
MFA_ENCRYPTION_KEY_PREVIOUS=
MFA_REQUIRED=false
PUBLIC_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# filesystem requires an absolute durable mount; gridfs stores bytes in MongoDB.
STORAGE_BACKEND=filesystem
STORAGE_DIR=
STORAGE_PERSISTENT=false
PAYMENTS_PAUSED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Manual Pix: payment remains pending until an admin confirms receipt.
PIX_ENABLED=false
PIX_KEY=
PIX_KEY_TYPE=phone
PIX_RECEIVER_NAME=MV MULTIMARCAS
PIX_RECEIVER_CITY=VALPARAISO
PIX_RESERVATION_MINUTES=60
# Official Correios API. Keep disabled until the buyer has a business contract.
CORREIOS_ENABLED=false
CORREIOS_ENV=homologation
CORREIOS_USERNAME=
CORREIOS_API_CODE=
CORREIOS_ACCESS_TOKEN=
CORREIOS_POSTING_CARD=
CORREIOS_CONTRACT=
CORREIOS_DR=
CORREIOS_SERVICE_CODES=03298,03220
CORREIOS_ORIGIN_POSTAL_CODE=72871059
CORREIOS_ITEM_WEIGHT_GRAMS=500
CORREIOS_PACKAGE_LENGTH_CM=30
CORREIOS_PACKAGE_WIDTH_CM=25
CORREIOS_PACKAGE_HEIGHT_CM=10
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=
RESET_WEBHOOK_ALLOWED_HOSTS=
# Use "resend" for direct delivery or "webhook" for a custom provider.
AUTH_EMAIL_PROVIDER=webhook
# Direct Resend delivery. Verify the sender domain before production.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Custom webhook alternative. Never log the authorization or token fields.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=
AUTH_EMAIL_WEBHOOK_ALLOWED_HOSTS=
ORDER_RESERVATION_MINUTES=15
ORDER_RESERVATION_REAPER_SECONDS=60
# Consumed by the production Uvicorn command. Use only the exact trusted proxy IP/CIDR.
# Never set this to * on an internet-facing origin.
FORWARDED_ALLOW_IPS=
# The retired legacy broker cannot be enabled by this codebase.
GOOGLE_AUTH_ENABLED=false
