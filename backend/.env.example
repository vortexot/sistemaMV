APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=mv_multimarcas
# Generate a random secret (at least 32 bytes); never use this file as credentials.
JWT_SECRET=
PUBLIC_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
PAYMENTS_PAUSED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
RESET_WEBHOOK_URL=
RESET_WEBHOOK_TOKEN=
# Unverified legacy identity broker is disabled until replaced/validated.
GOOGLE_AUTH_ENABLED=false
# Somente no backend/terminal de migração; nunca use esta URL no frontend.
SUPABASE_DB_URL=
