# URL pública final, sem barra no fim. Gera canonical e sitemap.xml.
VITE_SITE_URL=

# Hospedagem em subdiretório, como GitHub Pages. Em desenvolvimento, use /.
VITE_BASE_PATH=/

# Backend público opcional. Vazio mantém /api no mesmo domínio.
VITE_API_URL=

# Use true apenas para uma vitrine estática que consome public/catalog/*.json.
VITE_STATIC_CATALOG=false

# Google Analytics 4. Deixe vazio para não carregar nenhum script de tracking.
VITE_GA_MEASUREMENT_ID=

# Dados reais da loja física. Campos vazios não são exibidos nem incluídos no Schema.org.
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_TELEPHONE=
VITE_BUSINESS_OPENING_HOURS=
VITE_BUSINESS_MAP_URL=
VITE_BUSINESS_LATITUDE=
VITE_BUSINESS_LONGITUDE=
